{
  "name": "elizaos-plugin-sra-riskgate",
  "version": "0.1.1",
  "description": "SRA-RiskGate for ElizaOS: check stablecoin payments before an agent's wallet broadcasts them",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/gen_sanctions.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "parity": "python scripts/make_vectors.py test/vectors.json"
  },
  "keywords": [
    "elizaos",
    "elizaos-plugins",
    "agents",
    "stablecoin",
    "usdc",
    "payments",
    "risk",
    "guardrail",
    "ofac",
    "x402"
  ],
  "author": "Sriram Ramakrishnan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriram1983007-dev/elizaos-plugin-sra-riskgate.git"
  },
  "homepage": "https://github.com/sriram1983007-dev/elizaos-plugin-sra-riskgate",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "viem": "^2.21.55",
    "vitest": "^2.1.9"
  }
}
