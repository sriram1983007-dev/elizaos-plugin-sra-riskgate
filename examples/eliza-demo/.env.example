# Run `npm run wallet` and paste its lines here (test-network wallets only).
DEMO_PRIVATE_KEY=
KNOWN_PAYEES=
BLOCKED_ADDRESSES=0x000000000000000000000000000000000000dEaD

# Option 1: Google Gemini (set the key with the hidden prompt, never paste it into chat)
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_SMALL_MODEL=
# GOOGLE_LARGE_MODEL=
# GOOGLE_EMBEDDING_MODEL=

# Option 2: local Ollama (needs macOS 14+; start it with `ollama serve`)
OLLAMA_API_ENDPOINT=http://127.0.0.1:11434/api
OLLAMA_SMALL_MODEL=gemma3:4b
OLLAMA_MEDIUM_MODEL=gemma3:4b
OLLAMA_LARGE_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
